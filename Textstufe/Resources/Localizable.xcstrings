    "about.method.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples NaturalLanguage-Framework erkennt Wörter, Sätze, mögliche Grundformen und die Sprache. Danach wendet die App das veröffentlichte Zürcher ZIX-Modell an: Satzlänge, Anteil langer Wörter, Wortschatzabdeckung und Worthäufigkeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's NaturalLanguage framework finds words, sentences, possible lemmas, and the language. The app then applies the published Zurich ZIX model: sentence length, long-word ratio, vocabulary coverage, and word frequency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El framework NaturalLanguage de Apple identifica palabras, frases, posibles lemas e idioma. Después la app aplica el modelo ZIX de Zúrich publicado: longitud de frase, proporción de palabras largas, cobertura de vocabulario y frecuencia de palabras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le framework NaturalLanguage d’Apple identifie les mots, les phrases, les lemmes possibles et la langue. L’app applique ensuite le modèle ZIX de Zurich publié : longueur des phrases, proportion de mots longs, couverture du vocabulaire et fréquence des mots."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il framework NaturalLanguage di Apple identifica parole, frasi, possibili lemmi e la lingua. Poi l’app applica il modello ZIX di Zurigo pubblicato: lunghezza delle frasi, quota di parole lunghe, copertura del vocabolario e frequenza delle parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple の NaturalLanguage フレームワークが単語、文、見出し語、言語を判定します。その後、公開されているチューリッヒ ZIX モデルを適用します。文の長さ、長い単語の割合、語彙の網羅率、単語の頻度を使います。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Framework NaturalLanguage firmy Apple rozpoznaje słowa, zdania, możliwe lematy i język. Następnie aplikacja stosuje opublikowany model ZIX z Zurychu: długość zdań, udział długich słów, pokrycie słownictwa i częstość słów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A framework NaturalLanguage da Apple identifica palavras, frases, lemas possíveis e o idioma. Depois a app aplica o modelo ZIX de Zurique publicado: comprimento das frases, proporção de palavras longas, cobertura de vocabulário e frequência das palavras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фреймворк Apple NaturalLanguage определяет слова, предложения, возможные леммы и язык. Затем приложение применяет опубликованную модель ZIX из Цюриха: длину предложений, долю длинных слов, покрытие словаря и частотность слов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple’ın NaturalLanguage çerçevesi kelimeleri, cümleleri, olası kökleri ve dili belirler. Ardından uygulama yayımlanmış Zürih ZIX modelini uygular: cümle uzunluğu, uzun kelime oranı, kelime kapsamı ve kelime sıklığı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фреймворк Apple NaturalLanguage визначає слова, речення, можливі леми та мову. Далі застосунок застосовує опубліковану модель ZIX із Цюриха: довжину речень, частку довгих слів, покриття словника й частотність слів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 的 NaturalLanguage 框架识别单词、句子、可能的词形原形和语言。随后应用使用公开的苏黎世 ZIX 模型：句子长度、长词比例、词汇覆盖率和词频。"
          }
        }
      }
    },
    "about.method.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie wird bewertet?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How is it scored?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo se evalúa?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment est-ce évalué ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come viene valutato?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのように評価しますか？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak działa ocena?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como é avaliado?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как оценивается текст?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasıl değerlendirilir?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як оцінюється текст?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如何评分？"
          }
        }
      }
    },
    "about.minimum.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einzelnes Wort wie „Hallo“ sagt praktisch nichts über die Schwierigkeit eines Textes aus. Deshalb vergibt Textstufe erst ab 50 Wörtern in mindestens drei Sätzen eine Stufe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single word like “Hallo” says almost nothing about the difficulty of a text. Textstufe therefore assigns a level only from 50 words in at least three sentences."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola palabra como «Hallo» no dice casi nada sobre la dificultad de un texto. Por eso Textstufe solo asigna un nivel a partir de 50 palabras en al menos tres frases."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mot isolé comme « Hallo » ne dit presque rien de la difficulté d’un texte. Textstufe n’attribue donc un niveau qu’à partir de 50 mots en au moins trois phrases."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una singola parola come «Hallo» non dice quasi nulla sulla difficoltà di un testo. Perciò Textstufe assegna un livello solo a partire da 50 parole in almeno tre frasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Hallo」のような単語一つでは、テキストの難しさはほとんど分かりません。そのため Textstufe は3文以上で50語以上の場合にのみレベルを表示します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojedyncze słowo jak „Hallo” prawie nic nie mówi o trudności tekstu. Dlatego Textstufe przyznaje poziom dopiero od 50 słów w co najmniej trzech zdaniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma única palavra como «Hallo» diz quase nada sobre a dificuldade de um texto. Por isso o Textstufe só atribui um nível a partir de 50 palavras em pelo menos três frases."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно слово вроде «Hallo» почти ничего не говорит о сложности текста. Поэтому Textstufe присваивает уровень только начиная с 50 слов в трёх предложениях."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "«Hallo» gibi tek bir kelime, bir metnin zorluğu hakkında neredeyse hiçbir şey söylemez. Bu yüzden Textstufe yalnızca en az üç cümlede 50 kelimeden itibaren seviye verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне слово, як-от «Hallo», майже нічого не каже про складність тексту. Тому Textstufe присвоює рівень лише починаючи з 50 слів у трьох реченнях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像 “Hallo” 这样的单个词几乎无法说明文本的难度。因此 Textstufe 仅在至少三个句子、50 个单词时才给出级别。"
          }
        }
      }
    },
    "about.minimum.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum mindestens 50 Wörter?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why at least 50 words?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué al menos 50 palabras?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi au moins 50 mots ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché almeno 50 parole?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なぜ50語以上？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlaczego co najmniej 50 słów?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque pelo menos 50 palavras?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почему не менее 50 слов?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neden en az 50 kelime?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чому щонайменше 50 слів?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为什么至少 50 个单词？"
          }
        }
      }
    },
    "about.offline.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Texte werden ausschließlich auf deinem Gerät verarbeitet. Die App verwendet keine Netzwerkverbindung, keine Benutzerkonten und keine Analyse-Server. Eingaben werden nicht dauerhaft gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Texts are processed only on your device. The app uses no network connection, no user accounts, and no analytics servers. Inputs are not stored permanently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los textos se procesan solo en tu dispositivo. La app no usa conexión de red, cuentas de usuario ni servidores de análisis. Las entradas no se guardan de forma permanente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les textes sont traités uniquement sur votre appareil. L’app n’utilise aucune connexion réseau, aucun compte utilisateur et aucun serveur d’analyse. Les saisies ne sont pas conservées durablement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I testi vengono elaborati solo sul tuo dispositivo. L’app non usa connessioni di rete, account utente né server di analisi. Gli input non vengono salvati in modo permanente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストは端末上でのみ処理されます。ネットワーク接続、ユーザーアカウント、分析サーバーは使用しません。入力内容は永続的に保存されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksty są przetwarzane wyłącznie na Twoim urządzeniu. Aplikacja nie używa połączenia sieciowego, kont użytkowników ani serwerów analitycznych. Wpisy nie są trwale zapisywane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os textos são processados apenas no seu dispositivo. A app não usa ligação de rede, contas de utilizador nem servidores de análise. As entradas não são guardadas permanentemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тексты обрабатываются только на вашем устройстве. Приложение не использует сеть, учётные записи и серверы аналитики. Введённые данные не сохраняются постоянно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metinler yalnızca cihazınızda işlenir. Uygulama ağ bağlantısı, kullanıcı hesabı veya analiz sunucusu kullanmaz. Girdiler kalıcı olarak saklanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тексти обробляються лише на вашому пристрої. Застосунок не використовує мережу, облікові записи та сервери аналітики. Введені дані не зберігаються постійно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本仅在您的设备上处理。应用不使用网络连接、用户账户或分析服务器。输入内容不会被永久保存。"
          }
        }
      }
    },
