    "about.privacy.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App sendet keine Texte an Dritte. Über die Schaltfläche „Ergebnis kopieren“ kannst du eine Zusammenfassung selbst in die Zwischenablage übernehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app sends no texts to third parties. The “Copy result” button lets you place a summary on the clipboard yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no envía textos a terceros. El botón «Copiar resultado» te permite poner un resumen en el portapapeles tú mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app n’envoie aucun texte à des tiers. Le bouton « Copier le résultat » vous permet de placer vous-même un résumé dans le presse-papiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app non invia testi a terzi. Il pulsante «Copia risultato» ti permette di mettere tu stesso un riepilogo negli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストを第三者に送信することはありません。「結果をコピー」ボタンで、要約を自分でクリップボードにコピーできます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja nie wysyła tekstów do osób trzecich. Przycisk „Kopiuj wynik” pozwala samodzielnie umieścić podsumowanie w schowku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A app não envia textos a terceiros. O botão «Copiar resultado» permite-lhe colocar um resumo na área de transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение не отправляет тексты третьим лицам. Кнопка «Скопировать результат» позволяет вам самим поместить сводку в буфер обмена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama metinleri üçüncü taraflara göndermez. «Sonucu kopyala» düğmesiyle bir özeti kendiniz panoya kopyalayabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок не надсилає тексти третім особам. Кнопка «Скопіювати результат» дозволяє вам самостійно помістити підсумок у буфер обміну."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用不会将文本发送给第三方。“复制结果”按钮可让你自行将摘要放入剪贴板。"
          }
        }
      }
    },
    "about.privacy.title": {
      "localizations": {
        "de": {
          "stringUnit": {
