    "about.reliability.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstufung ist eine grobe Orientierung, kein wissenschaftlich validierter Test und keine offizielle GER-Bewertung. Besonders Fachtexte, Eigennamen und ungewöhnliche Formulierungen können das Ergebnis verfälschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The estimate is a rough indication, not a scientifically validated test and not an official CEFR rating. Technical texts, proper names, and unusual phrasing can distort the result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La estimación es una orientación aproximada, no una prueba validada científicamente ni una calificación MCER oficial. Los textos técnicos, los nombres propios y las formulaciones inusuales pueden distorsionar el resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’estimation est une indication approximative, pas un test validé scientifiquement ni une évaluation CECRL officielle. Les textes techniques, les noms propres et les formulations inhabituelles peuvent fausser le résultat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stima è un’indicazione approssimativa, non un test scientificamente validato né una valutazione QCER ufficiale. Testi tecnici, nomi propri e formulazioni inusuali possono alterare il risultato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "評価はおおよその目安であり、科学的に検証されたテストでも公式の CEFR 評価でもありません。専門文書、固有名詞、特殊な表現では結果がずれることがあります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocena to przybliżona wskazówka, nie test naukowo potwierdzony i nie oficjalna ocena CEFR. Teksty fachowe, nazwy własne i nietypowe sformułowania mogą zniekształcić wynik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A estimativa é uma indicação aproximada, não um teste validado cientificamente nem uma avaliação QECR oficial. Textos técnicos, nomes próprios e formulações invulgares podem distorcer o resultado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценка — это примерный ориентир, а не научно проверенный тест и не официальная оценка CEFR. Технические тексты, имена собственные и необычные формулировки могут исказить результат."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahmin kaba bir göstergedir; bilimsel olarak doğrulanmış bir test ya da resmi CEFR değerlendirmesi değildir. Teknik metinler, özel adlar ve sıra dışı ifadeler sonucu bozabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінка — це приблизний орієнтир, а не науково перевірений тест і не офіційна оцінка CEFR. Технічні тексти, власні назви та незвичні формулювання можуть викривити результат."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "评估只是大致参考，不是经过科学验证的测试，也不是官方 CEFR 评级。专业文本、专有名词和不寻常的表达可能使结果失真。"
          }
        }
      }
    },
