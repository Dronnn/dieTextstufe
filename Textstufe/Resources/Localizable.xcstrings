    "about.zix.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe überträgt die sechs Merkmale und die trainierten Koeffizienten von ZIX v0.2.5 (Kanton Zürich, MIT). Hinzu kommen Mindestlänge, Deutsch-Erkennung und ein Unsicherheitsbereich. Abweichungen bei der Grundformen-Erkennung können Ergebnisse leicht verschieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe ports the six features and trained coefficients of ZIX v0.2.5 (Canton of Zurich, MIT). The app adds a minimum length, German-language detection, and an uncertainty band. Differences in lemmatization can shift results slightly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe traslada las seis características y los coeficientes entrenados de ZIX v0.2.5 (Cantón de Zúrich, MIT). La app añade una longitud mínima, detección de alemán y un margen de incertidumbre. Las diferencias de lematización pueden desplazar ligeramente los resultados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe porte les six caractéristiques et les coefficients entraînés de ZIX v0.2.5 (canton de Zurich, MIT). L’app ajoute une longueur minimale, la détection de l’allemand et une marge d’incertitude. Des différences de lemmatisation peuvent décaler légèrement les résultats."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe porta le sei caratteristiche e i coefficienti addestrati di ZIX v0.2.5 (Canton Zurigo, MIT). L’app aggiunge una lunghezza minima, il rilevamento del tedesco e un margine di incertezza. Differenze nella lemmatizzazione possono spostare leggermente i risultati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe は ZIX v0.2.5（チューリッヒ州、MIT）の6つの特徴量と学習済み係数を移植しています。さらに最小文字数、ドイツ語判定、不確実性の範囲を追加しています。見出し語の判定の違いにより結果が少しずれることがあります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe przenosi sześć cech i wytrenowane współczynniki ZIX v0.2.5 (kanton Zurych, MIT). Aplikacja dodaje minimalną długość, wykrywanie języka niemieckiego i margines niepewności. Różnice w lematyzacji mogą nieznacznie przesuwać wyniki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Textstufe transporta as seis características e os coeficientes treinados do ZIX v0.2.5 (Cantão de Zurique, MIT). A app acrescenta um comprimento mínimo, deteção de alemão e uma margem de incerteza. Diferenças na lematização podem deslocar ligeiramente os resultados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe переносит шесть признаков и обученные коэффициенты ZIX v0.2.5 (кантон Цюрих, MIT). Приложение добавляет минимальную длину, определение немецкого языка и зону неопределённости. Различия в лемматизации могут немного смещать результаты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe, ZIX v0.2.5’in (Zürih Kantonu, MIT) altı özelliğini ve eğitilmiş katsayılarını taşır. Uygulama minimum uzunluk, Almanca algılama ve belirsizlik aralığı ekler. Kök biçim belirlemedeki farklılıklar sonuçları biraz kaydırabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe переносить шість ознак і навчені коефіцієнти ZIX v0.2.5 (кантон Цюрих, MIT). Застосунок додає мінімальну довжину, визначення німецької мови та зону невизначеності. Відмінності в лематизації можуть трохи зміщувати результати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe 移植了 ZIX v0.2.5（苏黎世州，MIT）的六个特征和训练系数。应用增加了最小长度、德语检测和不确定范围。词形还原的差异可能使结果略有偏移。"
          }
        }
      }
    },
