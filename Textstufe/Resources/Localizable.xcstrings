    "explanation.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Niveau beschreibt nur die grobe Leseschwierigkeit. Die Auswertung berücksichtigt Wortschatz, Wortlängen und Satzlängen. Sie misst nicht deine persönliche Sprachkompetenz und ist keine GER-Zertifizierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The level describes only the rough reading difficulty. The estimate considers vocabulary, word lengths, and sentence lengths. It does not measure your personal language proficiency and is not a CEFR certification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nivel describe solo la dificultad de lectura aproximada. La evaluación tiene en cuenta el vocabulario, la longitud de las palabras y de las frases. No mide tu competencia personal y no es una certificación MCER."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le niveau décrit uniquement la difficulté de lecture approximative. L’évaluation tient compte du vocabulaire, de la longueur des mots et des phrases. Elle ne mesure pas votre compétence personnelle et ne constitue pas une certification CECRL."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il livello descrive solo la difficoltà di lettura approssimativa. La valutazione considera vocabolario, lunghezza delle parole e delle frasi. Non misura la tua competenza personale e non è una certificazione QCER."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レベルはおおよその読みやすさだけを示します。評価には語彙、単語の長さ、文の長さが使われます。あなたの語学力を測るものではなく、CEFR の認定でもありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poziom opisuje tylko przybliżoną trudność czytania. Ocena uwzględnia słownictwo, długość słów i zdań. Nie mierzy Twoich osobistych kompetencji językowych i nie jest certyfikatem CEFR."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O nível descreve apenas a dificuldade de leitura aproximada. A avaliação considera o vocabulário, o comprimento das palavras e das frases. Não mede a sua competência pessoal e não é uma certificação QECR."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уровень описывает только примерную сложность чтения. Оценка учитывает словарный запас, длину слов и длину предложений. Она не измеряет вашу личную языковую компетенцию и не является сертификацией CEFR."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seviye yalnızca yaklaşık okuma zorluğunu gösterir. Değerlendirme kelime dağarcığını, kelime ve cümle uzunluğunu dikkate alır. Kişisel dil yeterliliğinizi ölçmez ve CEFR sertifikası değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рівень описує лише приблизну складність читання. Оцінка враховує словниковий запас, довжину слів і речень. Вона не вимірює вашу особисту мовну компетентність і не є сертифікацією CEFR."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "级别只描述大致的阅读难度。评估会考虑词汇、词长和句长。它不衡量你的个人语言能力，也不是 CEFR 认证。"
          }
        }
      }
    },
