    "state.notGerman.detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache wurde nicht sicher als Deutsch erkannt. Prüfe den Text und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The language was not confidently recognized as German. Check the text and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma no se reconoció como alemán con certeza. Revisa el texto e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue n’a pas été reconnue comme de l’allemand avec certitude. Vérifiez le texte et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua non è stata riconosciuta con certezza come tedesco. Controlla il testo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドイツ語と確実に判定できませんでした。テキストを確認してもう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Język nie został pewnie rozpoznany jako niemiecki. Sprawdź tekst i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma não foi reconhecido com certeza como alemão. Verifique o texto e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык не был уверенно распознан как немецкий. Проверьте текст и попробуйте снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dil kesin olarak Almanca tanınmadı. Metni kontrol edip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мову не було впевнено розпізнано як німецьку. Перевірте текст і спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能确定语言为德语。请检查文本后重试。"
          }
        }
      }
    },
