    "donations.priceNote": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Preise legt der App Store für dein Land fest und bucht sie über dein Apple-Konto ab. Beiträge sind freiwillige, verbrauchbare Trinkgelder. Sie schalten keine Funktionen frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prices are set by the App Store for your country and charged to your Apple Account. Donations are optional, consumable tips. They do not unlock features."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios los fija el App Store para tu país y se cobran en tu cuenta de Apple. Las donaciones son propinas opcionales y consumibles. No desbloquean funciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prix sont fixés par l’App Store pour votre pays et débités sur votre compte Apple. Les dons sont des pourboires facultatifs et consommables. Ils ne débloquent aucune fonction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prezzi sono stabiliti dall’App Store per il tuo paese e addebitati sul tuo account Apple. Le donazioni sono mance facoltative e consumabili. Non sbloccano funzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格はお住まいの国の App Store が設定し、Apple アカウントに請求されます。支援は任意の都度課金のチップです。機能は解放されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceny ustala App Store dla Twojego kraju i obciąża nimi Twoje konto Apple. Wpłaty to dobrowolne, jednorazowe napiwki. Nie odblokowują funkcji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os preços são definidos pela App Store para o seu país e cobrados na sua conta Apple. As doações são gorjetas opcionais e consumíveis. Não desbloqueiam funcionalidades."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цены устанавливает App Store для вашей страны и списывает с вашего аккаунта Apple. Пожертвования — добровольные одноразовые чаевые. Они не открывают функции."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiyatlar ülkeniz için App Store tarafından belirlenir ve Apple Hesabınızdan tahsil edilir. Bağışlar isteğe bağlı, tüketilebilir bahşişlerdir. Hiçbir özelliğin kilidini açmazlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціни встановлює App Store для вашої країни й списує з вашого облікового запису Apple. Пожертви — добровільні одноразові чайові. Вони не відкривають функції."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "价格由你所在国家/地区的 App Store 设定，并通过你的 Apple 账户扣款。打赏是可选的消耗型小费，不会解锁任何功能。"
          }
        }
      }
    },
