    "donations.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe wird von einem Entwickler gestaltet, gebaut und gepflegt. Wenn dir die App hilft, ist ein Beitrag willkommen. Alles bleibt so oder so verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe is designed, built, and maintained by one developer. If it helps you, a tip is appreciated. Everything stays available either way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe lo diseña, desarrolla y mantiene un solo desarrollador. Si te ayuda, se agradece una propina. Todo sigue disponible en cualquier caso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe est conçu, développé et maintenu par un seul développeur. Si l’app vous aide, un pourboire est apprécié. Tout reste disponible dans tous les cas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe è ideata, sviluppata e mantenuta da un solo sviluppatore. Se ti è utile, una mancia è gradita. Tutto resta disponibile in ogni caso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe は一人の開発者が設計・開発・維持しています。お役に立てているなら、チップをいただけると嬉しいです。いずれの場合もすべての機能は利用できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe projektuje, tworzy i utrzymuje jeden deweloper. Jeśli aplikacja Ci pomaga, napiwek będzie mile widziany. Wszystko pozostaje dostępne tak czy inaczej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Textstufe é concebido, desenvolvido e mantido por um único programador. Se a app o ajuda, uma gorjeta é bem-vinda. Tudo continua disponível de qualquer forma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe придумывает, разрабатывает и поддерживает один разработчик. Если приложение вам помогает, буду признателен за поддержку. Всё остаётся доступным в любом случае."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe tek bir geliştirici tarafından tasarlanıyor, geliştiriliyor ve sürdürülüyor. İşinize yarıyorsa bir bahşiş memnuniyetle karşılanır. Her durumda her şey kullanılabilir kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe створює й підтримує один розробник. Якщо застосунок вам допомагає, буду вдячний за підтримку. Усе залишається доступним у будь-якому разі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Textstufe 由一位开发者设计、开发与维护。如果它对你有所帮助，欢迎打赏。无论如何，所有功能都保持可用。"
          }
        }
      }
    },
