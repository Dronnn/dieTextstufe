    "state.tooShort.detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine sinnvolle Einschätzung brauchen wir mindestens 50 Wörter in drei Sätzen. Einzelne Wörter wie „Hallo“ erhalten bewusst kein Niveau."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A meaningful estimate needs at least 50 words in three sentences. Single words like “Hallo” deliberately receive no level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una estimación útil necesita al menos 50 palabras en tres frases. Palabras sueltas como «Hallo» no reciben nivel a propósito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une estimation utile nécessite au moins 50 mots en trois phrases. Les mots isolés comme « Hallo » ne reçoivent volontairement aucun niveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stima utile richiede almeno 50 parole in tre frasi. Parole singole come «Hallo» non ricevono volutamente alcun livello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "意味のある評価には、3文以上で50語以上が必要です。「Hallo」のような単語には意図的にレベルを付けません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do sensownej oceny potrzeba co najmniej 50 słów w trzech zdaniach. Pojedyncze słowa, takie jak „Hallo”, celowo nie otrzymują poziomu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma estimativa útil requer pelo menos 50 palavras em três frases. Palavras isoladas como «Hallo» não recebem nível de propósito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для осмысленной оценки нужно не менее 50 слов в трёх предложениях. Отдельные слова вроде «Hallo» намеренно не получают уровня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlamlı bir tahmin için üç cümlede en az 50 kelime gerekir. «Hallo» gibi tek kelimeler bilerek seviye almaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для змістовної оцінки потрібно щонайменше 50 слів у трьох реченнях. Окремі слова, як-от «Hallo», навмисно не отримують рівня."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有意义的评估需要至少三个句子、50 个单词。像 “Hallo” 这样的单个词故意不给出级别。"
          }
        }
      }
    },
