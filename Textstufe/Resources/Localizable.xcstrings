    "donations.thankYou.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Unterstützung hilft, Textstufe unabhängig zu halten. Es wird nichts freigeschaltet, und die App bleibt genau wie sie ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your support helps keep Textstufe independent. Nothing is unlocked, and the app stays exactly as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu apoyo ayuda a que Textstufe siga siendo independiente. No se desbloquea nada y la app sigue exactamente igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre soutien aide Textstufe à rester indépendant. Rien n’est débloqué et l’app reste exactement telle quelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo sostegno aiuta Textstufe a restare indipendente. Non viene sbloccato nulla e l’app resta esattamente com’è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご支援は Textstufe の独立性を支えます。機能は何も解放されず、アプリはそのまま変わりません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje wsparcie pomaga zachować niezależność Textstufe. Nic nie zostaje odblokowane, a aplikacja pozostaje dokładnie taka sama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu apoio ajuda o Textstufe a manter-se independente. Nada é desbloqueado e a app fica exatamente como está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша поддержка помогает Textstufe оставаться независимым. Ничего не открывается, и приложение остаётся точно таким же."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteğiniz Textstufe’un bağımsız kalmasına yardımcı olur. Hiçbir şeyin kilidi açılmaz ve uygulama olduğu gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша підтримка допомагає Textstufe залишатися незалежним. Нічого не відкривається, і застосунок залишається точно таким самим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的支持帮助 Textstufe 保持独立。不会解锁任何内容，应用保持原样。"
          }
        }
      }
    },
